# Copy to docker/.env and uncomment any line that conflicts with another stack
# you run on this host. All bindings are 127.0.0.1-only, so values like 18000
# stay private to localhost.

# ASTROLIFT_DJANGO_PORT=8000
# ASTROLIFT_UI_PORT=3000

# ASTROLIFT_POSTGRES_PORT=5432
# ASTROLIFT_REDIS_PORT=6379
# ASTROLIFT_OPENSEARCH_PORT=9200

# ASTROLIFT_TEMPORAL_GRPC_PORT=7233
# ASTROLIFT_TEMPORAL_UI_PORT=8233

# ASTROLIFT_MINIO_S3_PORT=9000
# ASTROLIFT_MINIO_CONSOLE_PORT=9001

# ASTROLIFT_MAILPIT_WEB_PORT=8025
# ASTROLIFT_MAILPIT_SMTP_PORT=1025

# ASTROLIFT_POSTGRES_EXPORTER_PORT=9187
# ASTROLIFT_REDIS_EXPORTER_PORT=9121

# API origin reachable from tenant pods for private builder artifact downloads.
# BUILDER_ARTIFACT_BASE_URL=https://api.your-install.example
