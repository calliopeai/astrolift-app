# --- Astrolift API ---
# In dev we proxy /app/* and /health/* through Next.js so the browser
# treats UI + API as the same origin (Django sessionid cookie just
# works). NEXT_PUBLIC_API_ROOT is left blank in dev — API calls hit
# the relative URL on localhost:3000 and Next.js forwards.
NEXT_PUBLIC_API_ROOT=
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/app/gql/config/

# --- App ---
NEXT_PUBLIC_MAIN_PAGE='/app'
APP_BASE_URL='http://localhost:3000'

# Set to '1' to use the backend's /app/auth1/dev-login bypass instead
# of the real Auth0 round-trip. Only honored when the Django
# DEBUG=True; the backend returns 404 in any other build.
NEXT_PUBLIC_DEV_LOGIN=1

# --- Auth0 (only required when NEXT_PUBLIC_DEV_LOGIN is unset) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# --- Platform status page (optional) ---
# Public Statuspage.io base URL — when set, the footer surfaces a link
# and a top-of-page banner appears when there are unresolved incidents
# (auto-refreshed every 60s from {URL}/api/v2/summary.json).
NEXT_PUBLIC_STATUS_PAGE_URL=

# --- Sentry (optional) ---
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_ORG=
