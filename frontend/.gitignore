# Codegen output IS committed so contributors don't need a running
# backend to typecheck the frontend, and so CI can diff the
# generated file against the schema to catch drift. Re-run
# `make codegen-all` after any schema change.

# IDE
.idea/
.vscode/

# Storybook build output
/storybook-static

# Playwright layout test output
/test-results
/playwright-report
