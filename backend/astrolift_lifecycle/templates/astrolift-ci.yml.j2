# Managed by Astrolift — do not edit by hand. Re-sync via Settings → CI setup → Sync workflow file.
name: astrolift deploy

on:
  push:
    branches: [{{ deploy_branch }}]
  workflow_dispatch: {}

permissions:
  id-token: write
  contents: read

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: {{ push_role_arn }}
          aws-region: us-west-2
          role-session-name: astrolift-${{ github.run_id }}
{% if platform_built %}

      - name: Login to Amazon ECR
        id: ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build and push image
        env:
          IMAGE: {{ ecr_uri }}:${{ github.sha }}
        run: |
          docker build -t "$IMAGE" .
          docker push "$IMAGE"
{% endif %}

      - name: Notify Astrolift
        env:
          API_URL: {{ api_url }}
          APP_SLUG: {{ app_slug }}
          TOKEN: ${{ secrets.ASTROLIFT_DEPLOY_TOKEN }}
          IMAGE: {{ image_ref }}
        run: |
          curl --fail-with-body -sS -X POST "$API_URL/api/v1/deploys" \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -d "{\"appSlug\":\"$APP_SLUG\",\"image\":\"$IMAGE\",\"commitSha\":\"${{ github.sha }}\"}"
