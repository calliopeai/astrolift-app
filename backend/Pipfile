[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
async-timeout = "*"
psycopg2-binary = "*"
redis = "*"
whitenoise = "*"   # Serves Django static assets from the app server (e.g. /static/admin/css/*) without a separate static-asset host
authlib = "==1.6.9" # Required for Auth0
boto3 = "==1.43.71"
cachetools = "==5.3.1"
python-dotenv = "*"
sentry-sdk = {extras = ["django"], version = "*"}
ecs-logging = "*"
django-import-export = "*"
django-constance = {extras = ["database"], version = "*"}
django-ses = "*"
django-health-check = "<4"
django-sslserver = "*"
django-crontab = "*"
opentelemetry-api = "*"
pydash = "*"
emoji = "*"
firebase-admin = "*"
freezegun = "*"
PyJWT = "*"
opensearch-py = "*"
opensearch-dsl = "*"
reportlab = "*"
djangorestframework = "*"
twilio = "*"
django-role-permissions = "*"
phonenumbers = "*"
pytz = "*"
django-cors-headers = "*"
django-nested-admin = "*"
netaddr = "*"
django-phonenumber-field = "*"
django-storages = "*"
django-filter = "*"
django-money = "*"
temporalio = "*"
opentelemetry-exporter-otlp-proto-http = "*"
opentelemetry-exporter-prometheus = "*"
opentelemetry-instrumentation-django = "*"
opentelemetry-sdk = "*"
pillow = "*"
django-simple-history = "*"
django-ratelimit = "*"
strawberry-graphql = {extras = ["django"], version = ">=0.235.0"}
strawberry-graphql-django = ">=0.47.0"
jsonschema = "*"
# Subscriptions need an ASGI server + Strawberry's ASGI integration
# (which depends on starlette). uvicorn handles HTTP + WebSocket in
# the same process and reloads on source changes.
starlette = "*"
"uvicorn[standard]" = "*"
websockets = "*"
# tomllib (stdlib) reads TOML; emitting requires a separate lib.
# Used by the manifest auto-discoverer (#119) to serialise the
# inferred manifest dict into a TOML string for the UI / SCM PR.
tomli-w = "*"
# Anthropic SDK — used by the skill AI assist endpoint (#884) to call
# claude-sonnet-4-6 directly for system-prompt suggestions.
anthropic = ">=0.40.0"
# libsodium sealed-box for the GitHub Actions secrets push (#383).
# GitHub's secret-write API requires Curve25519 sealed-box encryption
# of each secret value under the repo's public key. pynacl wraps
# libsodium so we don't shell out to ``openssl`` or carry our own
# crypto.
pynacl = "*"
# The kubernetes python client used to live here for the runtime
# observability surface (astroliftAppPods + onAppLog). After #299
# it moved to astrolift-providers[k8s] / [aws] / [gcp] / [azure]
# extras (installed via the vendored package in the Dockerfile) so
# every cloud-specific auth quirk stays inside the driver that
# owns it. Don't add kubernetes back here.

[dev-packages]
django-debug-toolbar = "*"
jsonpath-ng = "*"
pre-commit = "*"
pytest = "*"
pytest-django = "*"
pytest-asyncio = "*"
# moto fakes the AWS APIs the provider tests exercise (providers/tests/aws,
# astrolift_* tests that mint EKS tokens / managed-service plans). The
# providers package declares it under its own ``dev`` extra; mirror it here
# so the backend image's test suite (which imports those modules) can run.
# Extras match providers/pyproject.toml's dev extra.
moto = {extras = ["s3", "iam", "sts", "ec2", "eks", "route53", "acm", "ecr", "secretsmanager", "ssm", "sqs", "sns", "dynamodb", "elasticache", "rds", "efs"], version = ">=5.0"}


[requires]
python_version = "3.12"
