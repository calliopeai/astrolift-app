{
  "authorization": {
    "rule": "token scope and user RBAC permission are both required",
    "scheme": "bearer",
    "token_prefix": "alft_at_"
  },
  "endpoint": "/api/mcp/v1/",
  "protocol_versions": [
    "2025-03-26",
    "2025-06-18",
    "2025-11-25"
  ],
